<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>31bd0a2e-bd62-4b5f-a0c9-d21b6c46d95f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Customs Prototype</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="관세업무 도우미"/>
  <Description DefaultValue="관세업무 도우미 화면 프로토타입. 파일 읽기·수정 및 AI 연결 기능은 없습니다."/>
  <IconUrl DefaultValue="http://localhost:8000/static/excel/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="http://localhost:8000/static/excel/assets/icon-80.png"/>
  <SupportUrl DefaultValue="http://localhost:8000/static/excel/taskpane.html"/>
  <AppDomains><AppDomain>http://localhost:8000</AppDomain></AppDomains>
  <Hosts><Host Name="Workbook"/></Hosts>
  <DefaultSettings><SourceLocation DefaultValue="http://localhost:8000/static/excel/taskpane.html"/></DefaultSettings>
  <Permissions>Restricted</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Workbook"><DesktopFormFactor>
      <GetStarted><Title resid="GetStarted.Title"/><Description resid="GetStarted.Description"/><LearnMoreUrl resid="Taskpane.Url"/></GetStarted>
      <FunctionFile resid="Taskpane.Url"/>
      <ExtensionPoint xsi:type="PrimaryCommandSurface"><OfficeTab id="TabHome"><Group id="Customs.Group">
        <Label resid="Group.Label"/>
        <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
        <Control xsi:type="Button" id="Customs.OpenPane">
          <Label resid="Button.Label"/>
          <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ShowTaskpane"><TaskpaneId>Customs.Assistant</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="http://localhost:8000/static/excel/assets/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="http://localhost:8000/static/excel/assets/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="http://localhost:8000/static/excel/assets/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="http://localhost:8000/static/excel/taskpane.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="GetStarted.Title" DefaultValue="관세업무 도우미"/><bt:String id="Group.Label" DefaultValue="관세업무"/><bt:String id="Button.Label" DefaultValue="도우미 열기"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="GetStarted.Description" DefaultValue="홈 탭에서 도우미 열기를 선택해 화면을 살펴보세요."/><bt:String id="Button.Description" DefaultValue="관세업무 도우미 화면 프로토타입을 엽니다."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
